# Rendia — Environment Variables Template
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.

# Django
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Database (PostgreSQL — production only, ignored in local dev which uses SQLite)
DB_NAME=rendia_db
DB_USER=rendia_user
DB_PASSWORD=your-strong-password-here
DB_HOST=localhost
DB_PORT=5432

# Email (production SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=noreply@rendia.dz
EMAIL_HOST_PASSWORD=your-smtp-password
DEFAULT_FROM_EMAIL=noreply@rendia.dz

# SMS Gateway (to be configured in Phase 2)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# WhatsApp (Meta Cloud API — Phase 2)
# WHATSAPP_API_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
